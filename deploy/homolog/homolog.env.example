# HUNIT Control — variáveis do ambiente de homologação (specs/003, T056, quickstart §2.1)
#
# Copie para ".env.homolog" na raiz do repositório (o Git ignora) e preencha as vazias com
# valores NOVOS, diferentes dos de produção:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use sempre: docker compose --env-file .env.homolog <comando>

# ---------- Separação da produção (não mude) ----------
# Projeto próprio: containers, volumes e rede separados dos de produção ("hunit-control").
COMPOSE_PROJECT_NAME=hunit-homolog
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;deploy/homolog/docker-compose.homolog.yml

# ---------- Portas (diferentes das de produção) ----------
PORT=3100
HTTPS_PORT=8443
# Porta do banco, só em 127.0.0.1, para a carga dos dados fictícios.
HOMOLOG_DB_PORT=55432
# O app de homologação roda neste PC: https://localhost:8443
SERVER_HOSTNAME=localhost

# ---------- Segredos (novos, nunca os de produção) ----------
# Só letras e números.
POSTGRES_PASSWORD=
ACCOUNT_KEY_SECRET=
BACKUP_PASSPHRASE=

# ---------- Hunit ----------
# Endereço inválido de propósito: a homologação não acessa o Hunit (usa dados fictícios).
HUNIT_WEB_URL=https://hunit.invalid
HUNIT_API_URL=https://hunit-api.invalid

# ---------- Cópias de segurança ----------
# Pasta própria, fora da pasta das cópias de produção.
BACKUP_DIR=C:/hunit-homolog/backups
# Uma cópia por hora, para medir o tamanho antes e depois sem esperar um dia.
BACKUP_INTERVAL_HOURS=1
BACKUP_RETENTION_DAYS=2

# ---------- Planilha do Comercial (specs/005, quickstart §3 da 005) ----------
# Planilha de TESTE ("HUNIT Comercial — homologação"), nunca a planilha real do Comercial.
# Deixe as duas vazias até criar a planilha de teste e a conta de serviço; preencha as duas juntas.
COMMERCIAL_SHEET_ID=
COMMERCIAL_SHEET_KEY_FILE=
# COMMERCIAL_SHEET_KEY_FILE=/run/secrets/commercial-sheet/commercial-sheet-key.json
# Pasta própria para a chave da homologação: fora do repositório e da pasta da produção.
COMMERCIAL_SHEET_SECRETS_DIR=C:/hunit-homolog/secrets
# As concluídas saem da planilha de teste depois de 1 dia: dá para ver a retenção sem esperar 90.
COMMERCIAL_SHEET_DONE_RETENTION_DAYS=1
