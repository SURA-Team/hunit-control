{
  "name": "@hunit/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor do HUNIT Control: API HTTP e executor da automação do Hunit no mesmo processo",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "db:generate": "drizzle-kit generate",
    "hunit:login-check": "node dist/hunit-login-check.js",
    "hunit:reservations-check": "node dist/hunit-reservations-check.js"
  },
  "dependencies": {
    "@hunit/contracts": "workspace:*",
    "@hunit/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-openapi-glue": "^4.12.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright": "1.65.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11"
  }
}
