# HUNIT Control — variáveis de ambiente
#
# Copie este arquivo para ".env" e preencha os valores. O ".env" nunca vai para o Git.
# Para gerar valores aleatórios (funciona em qualquer terminal com Node.js):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------- Servidor ----------
# Porta HTTP da API. No Docker Compose ela só aceita conexões do próprio PC (127.0.0.1);
# as outras máquinas usam a porta HTTPS do proxy, abaixo.
PORT=3000
# Nível de log: fatal, error, warn, info, debug ou trace.
LOG_LEVEL=info

# ---------- Acesso pela rede (HTTPS) ----------
# Nome ou IP fixo do PC do servidor na rede, como as outras máquinas vão chamá-lo
# (ex.: 192.168.0.50 ou pc-financeiro). Obrigatório no Docker Compose. O certificado HTTPS é
# emitido para este nome; trocar o nome gera outro certificado, mas o certificado raiz (o que
# as máquinas clientes instalam) continua o mesmo.
SERVER_HOSTNAME=
# Porta HTTPS publicada para a rede. Libere esta porta no Firewall do Windows.
HTTPS_PORT=443

# ---------- Banco de dados ----------
# Senha do PostgreSQL criado pelo Docker Compose. Obrigatória.
# Use só letras e números (ela entra numa URL de conexão) — o comando acima serve.
POSTGRES_PASSWORD=
# URL de conexão usada pelo servidor quando ele roda FORA do Docker (desenvolvimento).
# No Docker Compose ela é montada automaticamente a partir de POSTGRES_PASSWORD.
DATABASE_URL=postgres://hunit:TROQUE_PELA_SENHA@localhost:5432/hunit

# ---------- Segurança ----------
# Segredo usado para identificar a conta do Hunit sem guardar o usuário (HMAC). Obrigatório.
# Não troque depois de começar a usar: o controle de "uma execução por conta" e o histórico
# de execuções dependem dele.
ACCOUNT_KEY_SECRET=

# ---------- Hunit ----------
HUNIT_WEB_URL=https://hunit.hsystem.com.br
HUNIT_API_URL=https://hunit-api.hsystem.com.br
# Tempo máximo, em segundos, que a execução espera o operador informar o token 2FA.
# O Hunit aceitou o token 491 s depois de a tela abrir; não passe disso sem medir de novo.
TWO_FACTOR_TIMEOUT_SECONDS=300
# Quantos hotéis processar ao mesmo tempo, com o mesmo login. 5 foi validado na homologação
# (rotina semanal em ~5 min, contra ~13 min com 1). Se o Hunit passar a recusar muitas leituras
# (avisos de "nova tentativa" e hotéis falhando), volte para 1.
HOTEL_CONCURRENCY=5
# Tamanho máximo, em dias, de cada consulta ao Hunit. Vazio = não dividir o período.
MAX_PERIOD_DAYS=

# ---------- Evidências e retenção ----------
# Pasta das evidências de falha. No Docker Compose é sempre /data/evidence (volume "evidence").
EVIDENCE_DIR=/data/evidence
# Dias que uma evidência fica guardada antes de ser apagada.
EVIDENCE_RETENTION_DAYS=30
# Anos após o check-in em que o nome do hóspede é anonimizado.
RESERVATION_RETENTION_YEARS=5

# ---------- Cópia de segurança (serviço "backup") ----------
# Pasta do PC onde ficam as cópias cifradas do banco. Obrigatória. Use uma pasta sincronizada
# com a nuvem (ex.: Google Drive para computador) ou um disco externo: a cópia precisa existir
# fora deste PC. Use caminho com barras normais, ex.: C:/Users/financeiro/Google Drive/hunit-backups
# (unidades de rede mapeadas por letra costumam não funcionar no Docker Desktop).
BACKUP_DIR=
# Frase que cifra as cópias. Obrigatória. Guarde-a fora do PC (ex.: gerenciador de senhas):
# sem ela as cópias não podem ser restauradas.
BACKUP_PASSPHRASE=
# Nova cópia quando a mais nova tiver mais de N horas (a verificação roda a cada 15 minutos).
BACKUP_INTERVAL_HOURS=24
# Dias que cada cópia fica guardada antes de ser apagada.
BACKUP_RETENTION_DAYS=30
