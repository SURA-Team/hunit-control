# ============================================================
# Segredos e credenciais
# ============================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.pfx
*.p12
**/credentials*.json
**/service_account*.json

# ============================================================
# Dados operacionais (reservas, cartões virtuais, planilhas)
# ============================================================
*.xlsx
*.xls
*.csv
*.tsv
*.db
*.sqlite
*.sqlite3
~$*

# ============================================================
# Legado (sistema Python antigo — apenas referência, nunca versionado aqui)
# Fica só na máquina de quem desenvolve: clone o repositório privado do legado em legacy/.
# Contém nomes de hotéis e da empresa, por isso não entra no repositório público.
# ============================================================
legacy/

# ============================================================
# Logs, execuções e evidências
# ============================================================
*.log
# Pastas de saída na raiz. O "/" inicial é importante: sem ele, a regra também esconderia
# pastas de código com o mesmo nome (ex.: apps/server/src/executions/).
/executions/
/screenshots/
/data/
test-results/
playwright-report/
playwright/.cache/

# Capturas de rede e fixtures brutas do Hunit (contêm dados de hóspedes e, no login, a senha).
# Só as fixtures anonimizadas são versionadas (tasks.md, T020/T021).
*.har
apps/server/test/fixtures/hunit/raw/

# ============================================================
# Node / TypeScript / Electron
# ============================================================
node_modules/
dist/
build/
out/
# Instaladores gerados pelo electron-builder (app desktop, specs/002)
apps/desktop/release/
coverage/
.vitest/
*.tsbuildinfo
.npm/
.pnpm-store/

# ============================================================
# Python (legado)
# ============================================================
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# IDE e sistema operacional
# ============================================================
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp

# ============================================================
